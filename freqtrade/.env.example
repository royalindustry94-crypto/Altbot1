# Copy this file to ".env" and change the 4 values below.
# Use long random text (letters + numbers, at least 32 characters).

# Login for the web screen at http://localhost:8080
FREQTRADE__API_SERVER__USERNAME=trader
FREQTRADE__API_SERVER__PASSWORD=change-me-to-a-long-random-password-123

# Internal secrets - just mash the keyboard, you never need to type these again
FREQTRADE__API_SERVER__JWT_SECRET_KEY=change-me-0123456789abcdefghijklmnopqrstuvwxyz
FREQTRADE__API_SERVER__WS_TOKEN=change-me-9876543210zyxwvutsrqponmlkjihgfedcba

# LATER (real money only): exchange keys. Trade-only, withdrawals OFF.
# FREQTRADE__EXCHANGE__KEY=
# FREQTRADE__EXCHANGE__SECRET=
