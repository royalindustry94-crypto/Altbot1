# Copy to .env, then: chmod 600 .env
# Keys: Read + Spot Trade ONLY. Withdrawals DISABLED. IP-restrict to your server.

# mode: testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# mode: live (different names on purpose — testnet and live keys can never be swapped by accident)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_API_PASSPHRASE=     # only exchanges like OKX / KuCoin use one

# Second safety key for mode: live
# ALTBOT_LIVE_CONFIRM=I_ACCEPT_REAL_MONEY_RISK
